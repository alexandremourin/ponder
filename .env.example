# --- Ponder configuration ---------------------------------------------------
# Copy this file to `.env` and add YOUR OWN key. Never commit your real .env.
#   cp .env.example .env

# Anthropic Claude is the primary LLM. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional fallback: if ANTHROPIC_API_KEY is empty, Ponder uses OpenAI instead.
# OPENAI_API_KEY=sk-your-openai-key-here

# --- Optional overrides (sensible defaults are built in) --------------------
# PONDER_ANTHROPIC_MODEL=claude-sonnet-4-6
# PONDER_OPENAI_MODEL=gpt-4o-mini
# PONDER_EMBED_MODEL=BAAI/bge-small-en-v1.5
# PONDER_CORPUS_DIR=data/corpus
# PONDER_TOP_K=5
# PONDER_MAX_REWRITES=2
# PONDER_MAX_CRITIQUE_RETRIES=1
